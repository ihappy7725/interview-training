# ── 필수 ──────────────────────────────────────────────
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-your-key-here

# ── 선택 (비워두면 기본값 사용) ──────────────────────────
# 질문 생성·평가·피드백에 쓰는 모델 (기본: gpt-5.4-mini)
OPENAI_CHAT_MODEL=gpt-5.4-mini
# 실제 기출 질문 웹 검색에 쓰는 모델 (기본: CHAT_MODEL과 동일)
OPENAI_SEARCH_MODEL=
# 음성 → 텍스트 모델 (기본: gpt-transcribe)
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# 추론 강도: low / medium / high (지원 모델에서만. 응답이 느리면 low)
OPENAI_REASONING_EFFORT=
