# 이 파일을 복사해서 .env를 만드세요:  cp .env.example .env
# .env는 .gitignore에 포함되어 GitHub에 올라가지 않습니다.
# .env를 고친 뒤에는 uvicorn 서버를 껐다가 다시 켜야 반영됩니다.

# ── ElevenLabs (질문 듣기 음성) ─────────────────────────
# https://elevenlabs.io/app/settings/api-keys 에서 발급. 비워 두면 브라우저 기본 음성을 씁니다.
ELEVENLABS_API_KEY=
# 비워 두면 기본값 사용 (main.py의 DEFAULT_MODEL_ID / DEFAULT_VOICE_IDS)
ELEVENLABS_MODEL_ID=
ELEVENLABS_VOICE_ID_KO=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_ZH=

# ── OpenAI (2단계부터) ──────────────────────────────────
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_SEARCH_MODEL=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_REASONING_EFFORT=
