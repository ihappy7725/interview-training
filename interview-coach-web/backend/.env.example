# 이 파일을 복사해서 .env를 만드세요:  cp .env.example .env
# .env는 .gitignore에 포함되어 GitHub에 올라가지 않습니다.
# .env를 고친 뒤에는 uvicorn 서버를 껐다가 다시 켜야 반영됩니다.
# Vercel에서는 이 파일 대신 Project Settings > Environment Variables에 같은 이름으로 넣으세요.

# ── OpenAI (질문 생성·웹 검색·전사·답변 평가) ───────────────
# https://platform.openai.com/api-keys 에서 발급. 비워 두면 AI 기능이 꺼지고 카메라 코칭·녹음 지표만 동작
OPENAI_API_KEY=
# 비워 두면 기본값: gpt-6-luna (2026-11 OpenAI 문서 기준 저비용 모델)
OPENAI_CHAT_MODEL=
OPENAI_SEARCH_MODEL=
# 비워 두면 기본값: gpt-transcribe
OPENAI_TRANSCRIBE_MODEL=
# 추론 강도: none / low / medium / high (비우면 모델 기본값. 응답이 느리면 low)
OPENAI_REASONING_EFFORT=

# ── 접근 코드 (공개 배포 시 필수) ─────────────────────────
# AI 기능을 쓰려면 화면에서 이 코드를 입력해야 합니다. 로컬에서 비워 두면 코드 없이 사용.
# Vercel에서 비워 두면 AI 기능이 잠깁니다(비용 보호). 길고 추측하기 어려운 값으로 정하세요.
APP_ACCESS_CODE=

# ── ElevenLabs (질문 듣기 음성) ─────────────────────────
# https://elevenlabs.io/app/settings/api-keys 에서 발급. 권한: Text to Speech(필수), Voices Read(음성 목록 조회용)
# 비워 두면 브라우저 기본 음성을 씁니다.
ELEVENLABS_API_KEY=
# 비워 두면 기본값: eleven_flash_v2_5
ELEVENLABS_MODEL_ID=
ELEVENLABS_VOICE_ID_KO=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_ZH=

# ── 선택: 질문 서명용 비밀값 ──────────────────────────────
# 비워 두면 서버가 ElevenLabs 키로부터 자동으로 만듭니다.
TTS_SIGNING_SECRET=
